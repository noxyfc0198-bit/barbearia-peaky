# Copie para .env (no computador/Termux) ou cadastre como variáveis de ambiente na Vercel.
# URL do seu projeto Supabase (já preenchida):
VITE_SUPABASE_URL=https://scbwmyylzdudnunkbtco.supabase.co
# Chave PUBLICÁVEL (Supabase > Project Settings > API Keys > "Publishable key", começa com sb_publishable_).
# Cole só aqui ou na Vercel. NUNCA use a chave "secret" / "service_role" em nenhum arquivo do app.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Slug da barbearia aberta em "/" (ex.: peaky)
VITE_DEFAULT_SLUG=peaky
